From: Chimera core
Subject: [PATCH] the core's memory tools see the Model 1 and Model 2 RAM

With SUPERMODEL_CHIMERA, CModel1 and CModel2 hand the core pointers to
their main RAM and their battery-backed RAM, which the core publishes as
memory domains for Chimera's memory tools (RAM Watch, RAM Search, Lua's
memory functions), as patch 0005 does for the Model 3.
---
--- a/Src/Model1/Model1.h
+++ b/Src/Model1/Model1.h
@@ -76,6 +76,16 @@
   void SaveState(CBlockFile *SaveState) override;
   void LoadState(CBlockFile *SaveState) override;
   bool SupportsSaveStates(void) const override { return true; }
+#ifdef SUPERMODEL_CHIMERA
+  // the Chimera core's memory tools (RAM Watch, RAM Search) read these: the
+  // battery-backed RAM and the main RAM, in the V60's (little-endian) order
+  uint8_t *ChimeraRAM(int index, int64_t *size)
+  {
+    std::vector<uint16_t> &v = index == 0 ? m_ramA : m_ramB;
+    *size = int64_t(v.size()) * 2;
+    return index == 0 || index == 1 ? reinterpret_cast<uint8_t *>(v.data()) : nullptr;
+  }
+#endif
   void SaveNVRAM(CBlockFile *NVRAM) override;
   void LoadNVRAM(CBlockFile *NVRAM) override;
   void ClearNVRAM(void) override;
--- a/Src/Model2/Model2.h
+++ b/Src/Model2/Model2.h
@@ -95,6 +95,17 @@
   void SaveState(CBlockFile *SaveState) override;
   void LoadState(CBlockFile *SaveState) override;
   bool SupportsSaveStates(void) const override { return true; }
+#ifdef SUPERMODEL_CHIMERA
+  // the Chimera core's memory tools (RAM Watch, RAM Search) read these: the
+  // RAM at 0x200000, the work RAM at 0x500000 and the battery-backed RAM, in
+  // the i960's (little-endian) order
+  uint8_t *ChimeraRAM(int index, int64_t *size)
+  {
+    std::vector<uint8_t> &v = index == 0 ? m_ram : index == 1 ? m_workRAM : m_backupRAM;
+    *size = int64_t(v.size());
+    return index >= 0 && index <= 2 ? v.data() : nullptr;
+  }
+#endif
   void SaveNVRAM(CBlockFile *NVRAM) override;
   void LoadNVRAM(CBlockFile *NVRAM) override;
   void ClearNVRAM(void) override;
