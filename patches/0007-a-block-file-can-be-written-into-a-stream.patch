+#ifdef SUPERMODEL_CHIMERA
+Result CBlockFile::Create(FILE *stream, const std::string &headerName, const std::string &comment)
+{
+  fp = stream;
+  if (NULL == fp)
+    return Result::FAIL;
+  mode = 'w';
+  WriteBlockHeader(headerName, comment);
+  return Result::OKAY;
+}
+#endif
